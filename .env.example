# Copy to .env for local development (`vercel dev`), and add the same
# variables in Vercel: Project → Settings → Environment Variables.

# From the Daily dashboard → Developers → API key. Server only, never commit it.
DAILY_API_KEY=

# Optional. Defaults shown.
ROOM_PREFIX=demo-
ROOM_DURATION_MINUTES=30
DEFAULT_LANG=cs

# Optional. Links are built from the request's domain unless this is set.
# PUBLIC_BASE_URL=https://your-site.vercel.app
